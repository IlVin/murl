package pgc

import (
	"context"
	"errors"
	"fmt"
	"iter"
	"sync"

	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/metric"
	metricNoop "go.opentelemetry.io/otel/metric/noop"
)

const otelNameClusterBatcher = "cluster_batcher"

// PgClusterBatcher управляет пулом батчеров для всех шардов кластера.
type PgClusterBatcher[T any] interface {
	Push(key any, args ...any) error
	All() iter.Seq2[T, error]
	Flush() error
	Close() error
}

type pgClusterBatcher[T any] struct {
	ctx     context.Context
	cluster PgCluster
	query   *Query[T]

	batchers []PgBatcher[T]

	meter metric.Meter
	mDist metric.Int64Counter
}

func NewPgClusterBatcher[T any](ctx context.Context, cluster PgCluster, q *Query[T]) PgClusterBatcher[T] {
	size := int(cluster.Size())
	batchers := make([]PgBatcher[T], size)

	for i := 0; i < size; i++ {
		shardID := byte(i)
		shard, _ := cluster.GetShard(shardID)
		batchers[shardID] = NewPgBatcher(ctx, shard, q)
	}

	b := &pgClusterBatcher[T]{
		ctx:      ctx,
		cluster:  cluster,
		query:    q,
		batchers: batchers,
		meter:    metricNoop.NewMeterProvider().Meter(getInstrumentationName(otelNameClusterBatcher)),
	}

	b.initMetrics()
	return b
}

func (b *pgClusterBatcher[T]) initMetrics() {
	b.mDist, _ = b.meter.Int64Counter("db.pgc.cluster.batcher.dist.total",
		metric.WithDescription("Distribution of pushes across shards"))
}

func (b *pgClusterBatcher[T]) WithMeterProvider(mp metric.MeterProvider) PgClusterBatcher[T] {
	if mp != nil {
		b.meter = mp.Meter(getInstrumentationName(otelNameClusterBatcher))
		b.initMetrics()
		for _, bt := range b.batchers {
			bt.WithMeterProvider(mp)
		}
	}
	return b
}

func (b *pgClusterBatcher[T]) Push(key any, args ...any) error {
	shardID := b.cluster.ShardID(key)

	b.mDist.Add(b.ctx, 1, metric.WithAttributes(
		attribute.Int("db.pgc.shard_id", int(shardID)),
	))

	return b.batchers[shardID].Push(args...)
}

func (b *pgClusterBatcher[T]) Flush() error {
	var errs []error
	for _, bt := range b.batchers {
		if err := bt.Flush(); err != nil {
			errs = append(errs, err)
		}
	}
	return errors.Join(errs...)
}

func (b *pgClusterBatcher[T]) All() iter.Seq2[T, error] {
	return func(yield func(T, error) bool) {
		// Никаких локов не нужно, слайс batchers неизменяем
		if len(b.batchers) == 0 {
			return
		}

		type resWrap struct {
			val T
			err error
		}
		ch := make(chan resWrap, 64)
		var wg sync.WaitGroup

		for _, bt := range b.batchers {
			wg.Add(1)
			go func(batcher PgBatcher[T]) {
				defer wg.Done()
				for v, err := range batcher.All() {
					select {
					case ch <- resWrap{val: v, err: err}:
					case <-b.ctx.Done():
						return
					}
				}
			}(bt)
		}

		go func() {
			wg.Wait()
			close(ch)
		}()

		for res := range ch {
			if !yield(res.val, res.err) {
				return
			}
		}
	}
}

func (b *pgClusterBatcher[T]) Close() error {
	var errs []error
	for id, bt := range b.batchers {
		if err := bt.Close(); err != nil {
			errs = append(errs, fmt.Errorf("shard %d: %w", id, err))
		}
	}
	return errors.Join(errs...)
}
